{
  "strategy": "browser",
  "url": "/pricing",
  "rows": "table.price-table tbody tr",
  "key": "td.model-name",
  "values": {
    "input": "td.input-price",
    "output": "td.output-price",
    "unit": "td.input-price@data-unit"
  },
  "numeric": ["input", "output"],
  "min": 0,
  "max": 1,
  "timeout_seconds": 45,
  "storage_state": "~/.config/newapi-upstream-intel/state/<host>.json"
}
